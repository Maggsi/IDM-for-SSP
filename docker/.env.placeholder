# Placeholder .env, copied into the image as /app/.env by the Dockerfile.
# It exists so Symfony's Dotenv::loadEnv('/app/.env') finds the file.
# Intentionally MINIMAL — real values are injected at runtime via the compose
# `environment:` block (Dotenv::loadEnv does NOT override already-set vars).
# The real, secret-bearing .env stays on the host (docker/.env, gitignored) and
# is NOT baked into the image.
#
# A few vars are referenced by the config via %env(...)% and MUST be present
# (even empty) or the kernel fails to boot — hence the empty defaults here.
APP_ENV=prod
SENTRY_DSN=
MAILER_DSN=null://null
